// AIDL lights HAL (FCM level 5 only lists android.hardware.light as AIDL)
cc_binary {
    name: "android.hardware.lights-service.sony_tone",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights-service.sony_tone.rc"],
    vintf_fragments: ["android.hardware.lights-service.sony_tone.xml"],
    srcs: ["service.cpp", "Lights.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-ndk_platform",
    ],
    vendor: true,
}
