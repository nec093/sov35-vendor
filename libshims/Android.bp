cc_library_shared {
    name: "libtone_shim",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "ims.cpp",
    ],
}

cc_library_shared {
    name: "libshim_binder",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "binder/PermissionCache.cpp",
    ],
}

cc_library {
    name: "libbase_shim",
    srcs: ["logging.cpp"],
    shared_libs: ["libbase"],
    vendor: true
}

cc_library {
    name: "libcutils_shim",
    srcs: [
        "strdup16to8.cpp",
        "strdup8to16.cpp",
    ],
    shared_libs: ["libcutils"],
}

cc_library_shared {
    name: "libexidx_shim",
    srcs: ["exidx.c"],
    compile_multilib: "32",
    vendor: true,
}
